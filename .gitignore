########## Unity ##########

## This .gitignore assumes that the Unity project is in its own sub-folder inside the repo's root
## Replace <UnityPrj-Subfolder> with the actual name of the Unity project

# Unity Project
/UValidationSandbox/[Ll]ibrary/
/UValidationSandbox/[Tt]emp/
/UValidationSandbox/[Oo]bj/
/UValidationSandbox/[Bb]uild/
/UValidationSandbox/[Bb]uilds/
/UValidationSandbox/[Ll]ogs/
/UValidationSandbox/[Mm]emoryCaptures/
/UValidationSandbox/[Uu]serSettings/
/UValidationSandbox/[Aa]ssets/_[Rr]ecovery
[Bb]uild/
[Bb]uilds/

# Sandbox settings are regenerated locally; retain only the required Unity version.
/UValidationSandbox/[Pp]rojectSettings/*
!/UValidationSandbox/[Pp]rojectSettings/ProjectVersion.txt

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/UValidationSandbox/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/UValidationSandbox/[Aa]ssets/Plugins/Editor/JetBrains*

# IDEs cache directory
.vs/
.vscode/
.idea/
/UValidationSandbox/.vs/
/UValidationSandbox/.vscode/
/UValidationSandbox/.idea/

# Gradle cache directory
/UValidationSandbox/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.vsconfig

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.unitypackage

# Crashlytics generated file
crashlytics-build.properties

# Editor configs
*.dwlt
*.log

# Ignore Blender backup files
*.blend[0-9]*
